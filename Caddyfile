{
	admin off
	servers {
		protocols h1 h2 h2c h3
	}
}

{$SITE_ADDRESS::8080} {
	root * /srv/mafia
	encode zstd gzip

	@grpc protocol grpc
	handle @grpc {
		reverse_proxy h2c://{$GRPC_UPSTREAM:api:9090}
	}

	@api path /api /api/* /healthz /readyz
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	handle /assets/* {
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
